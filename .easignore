tsconfig.json

# Build scripts (not needed on EAS server)
build-android.bat
build-android.ps1
build-android.sh

# Documentation (not needed for build)
BUILD_ANDROID.md
LOCAL_BUILD_NO_EAS.md
GITHUB_ACTIONS_BUILD.md
APK_BUILD_GUIDE.md
README.md

