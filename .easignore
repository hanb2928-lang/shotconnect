android/
ios/

# Build outputs
dist/
web-build/
.expo/

# Development configs
.bolt/
.github/

# Tests
__tests__/
tests/
supabase/tests/
supabase/functions/_shared/
playwright.config.ts
jest.config.js
jest.setup.ts
eslint.config.js
