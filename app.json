{
  "expo": {
    "name": "숏커넥트",
    "slug": "snap-and-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "shotconnect",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shotconnect.app",
      "jsEngine": "hermes",
      "infoPlist": {
        "NSCameraUsageDescription": "제품 촬영과 AI 분석을 위해 카메라를 사용합니다.",
        "NSMicrophoneUsageDescription": "영상 촬영 시 음성을 녹음하기 위해 마이크를 사용합니다."
      }
    },
    "android": {
      "package": "com.shotconnect.app",
      "jsEngine": "hermes",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#0a0f1e"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "4dfcf36f-1af0-409a-8c1d-25e107415ba1"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-system-ui",
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "expo-file-system",
      "expo-splash-screen",
      "expo-image-picker",
      "expo-camera",
      "expo-video",
      "expo-media-library",
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24,
            "buildToolsVersion": "36.0.0",
            "kotlinVersion": "2.1.20",
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so",
                "**/libfbjni.so",
                "**/libreactnativejni.so"
              ]
            }
          }
        }
      ],
      "./plugins/withGradleJvmArgs"
    ]
  }
}
