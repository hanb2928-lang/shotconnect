# ShortConnect ProGuard / R8 rules — generated by with-optimized-gradle plugin.
# Do not edit manually: changes are overwritten by expo prebuild.

# ── Critical: prevent R8 from renaming classes loaded by reflection ──
# Autolinking and TurboModule discovery use reflection by class name.
# Without this, R8 renames *Package classes and the app crashes on boot.
-dontobfuscate
-allowaccessmodification

# ── React Native core (full preservation) ──
-keep class com.facebook.react.** { *; }
-keep class com.facebook.react.turbomodule.** { *; }
-keep class com.facebook.react.bridge.** { *; }
-keep class com.facebook.react.module.** { *; }
-keep class com.facebook.react.uimanager.** { *; }
-keep class com.facebook.react.views.** { *; }
-keep class com.facebook.react.modules.** { *; }
-keep class com.facebook.react.devsupport.** { *; }
-keep class com.facebook.react.hermes.** { *; }
-keep class com.facebook.react.views.imagehelper.** { *; }

# ── Hermes JS engine ──
-keep class com.facebook.hermes.** { *; }
-keep class com.facebook.hermes.reactexecutor.** { *; }

# ── react-native-reanimated ──
-keep class com.swmansion.reanimated.** { *; }

# ── react-native-gesture-handler ──
-keep class com.swmansion.gesturehandler.** { *; }

# ── react-native-screens ──
-keep class com.swmansion.rnscreens.** { *; }

# ── react-native-worklets ──
-keep class com.swmansion.worklets.** { *; }

# ── react-native-svg ──
-keep class com.horcrux.svg.** { *; }

# ── react-native-webview ──
-keep class com.reactnativecommunity.webview.** { *; }
-keep class com.reactnativecommunity.** { *; }

# ── react-native-view-shot ──
-keep class fr.greweb.** { *; }

# ── Expo modules (broad — covers all expo-* packages) ──
-keep class expo.modules.** { *; }
-keep class expo.modules.blur.** { *; }
-keep class expo.modules.filesystem.** { *; }
-keep class expo.modules.haptics.** { *; }
-keep class expo.modules.imagemanipulator.** { *; }
-keep class expo.modules.imagepicker.** { *; }
-keep class expo.modules.camera.** { *; }
-keep class expo.modules.medialibrary.** { *; }
-keep class expo.modules.sharing.** { *; }
-keep class expo.modules.font.** { *; }
-keep class expo.modules.webbrowser.** { *; }
-keep class expo.modules.systemui.** { *; }
-keep class expo.modules.notifications.** { *; }
-keep class expo.modules.lineargradient.** { *; }
-keep class * extends expo.modules.kotlin.modules.Module { *; }
-keep class * extends expo.modules.kotlin.view.ExpoView { *; }
-keep class * extends expo.modules.core.BasePackage { *; }
-keep class * implements expo.modules.core.interfaces.Package { *; }

# ── AsyncStorage ──
-keep class com.reactnativecommunity.asyncstorage.** { *; }

# ── DateTimePicker ──
-keep class com.reactcommunity.rndatetimepicker.** { *; }

# ── SafeAreaContext ──
-keep class com.th3rdwave.safeareacontext.** { *; }

# ── React Native native module interfaces (catch-all for all native bridges) ──
-keep class * implements com.facebook.react.bridge.NativeModule { *; }
-keep class * implements com.facebook.react.bridge.JavaScriptModule { *; }
-keep class * implements com.facebook.react.turbomodule.coreTurboModule { *; }
-keep class * extends com.facebook.react.bridge.ReactContextBaseJavaModule { *; }
-keep class * extends com.facebook.react.bridge.BaseJavaModule { *; }

# ── @ReactModule annotation ──
-keep @interface com.facebook.react.module.annotations.ReactModule { *; }
-keep @com.facebook.react.module.annotations.ReactModule class * { *; }
-keepclassmembers @com.facebook.react.module.annotations.ReactModule class * { *; }

# ── Application class ──
-keep class com.snapconnect.app.** { *; }
-keep class com.snapconnect.app.MainApplication { *; }
-keep class com.snapconnect.app.MainActivity { *; }

# ── Kotlin metadata ──
-keep class kotlin.Metadata { *; }
-keepclassmembers class ** { @kotlin.Metadata *; }

# ── OkHttp / network stack ──
-keep class okhttp3.** { *; }
-keep interface okhttp3.** { *; }
-keep class okio.** { *; }
-keep class javax.annotation.** { *; }
-dontwarn okhttp3.**
-dontwarn okio.**
-dontwarn javax.annotation.**

# ── Google / AndroidX libs used by Expo ──
-keep class com.google.android.gms.** { *; }
-keep class androidx.work.** { *; }
-keep class androidx.core.** { *; }
-dontwarn com.google.android.gms.**
-dontwarn androidx.work.**

# ── Keep enum values for serialization ──
-keepclassmembers enum * {
    public static **[] values();
    public static ** valueOf(java.lang.String);
}

# ── Keep reflection-needed attributes ──
-keepattributes Signature
-keepattributes *Annotation*
-keepattributes EnclosingMethod
-keepattributes InnerClasses
-keepattributes RuntimeVisibleAnnotations
-keepattributes RuntimeInvisibleAnnotations

# ── Keep native (JNI) methods ──
-keepclasseswithmembernames class * {
    native <methods>;
}

# ── Keep all package classes (autolinking discovery) ──
-keep class **.**Package { *; }
-keep class * implements com.facebook.react.ReactPackage { *; }

# ── Suppress all remaining safe warnings ──
-dontwarn com.facebook.react.**
-dontwarn expo.modules.**
-dontwarn com.swmansion.**
-dontwarn com.horcrux.**
-dontwarn com.th3rdwave.**
-dontwarn com.reactnativecommunity.**
-dontwarn com.reactcommunity.**
-dontwarn fr.greweb.**
